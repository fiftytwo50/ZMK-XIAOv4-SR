//#include <behaviors/mouse_keys.dtsi>

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE  &kp N1         &kp N2     &kp N3    &kp N4     &kp N5   &kp N6          &kp N7        &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB    &kp Q          &kp W      &kp E     &kp R      &kp T    &kp C_AC_CUT    &bt BT_SEL 0  &kp Y      &kp U      &kp I      &kp O          &kp P     &kp NUBS
&kp ESC    &kp A          &kp S      &kp D     &kp F      &kp G    &kp C_AC_COPY   &bt BT_SEL 1  &kp H      &kp J      &kp K      &kp L          &kp SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X      &kp C     &kp V      &kp B    &kp C_AC_PASTE  &trans        &kp N      &kp M      &kp COMMA  &kp DOT        &kp FSLH  &kp RSHFT
&kp LCTRL  &kp CAPSLOCK   &kp F4     &kp LEFT  &kp RIGHT  &kp UP   &kp DOWN        &kp LBKT      &kp RBKT   &kp RCTRL
&mo 1      &kp BACKSPACE  &kp LCTRL  &kp LALT  &kp HOME   &kp END  &kp SPACE       &kp ENTER     &kp RCTRL  &kp RGUI   &kp PG_UP  &kp PAGE_DOWN
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans     &trans    &trans     &trans    &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans     &trans    &kp DEL    &kp LBKT  &trans  &trans  &kp RBKT  &kp N7  &kp N8  &kp N9  &kp ASTRK  &trans
&trans  &trans  &kp MINUS  &kp PLUS  &kp EQUAL  &kp LPAR  &trans  &trans  &kp RPAR  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &trans  &trans     &trans    &trans     &trans    &trans  &trans  &trans    &kp N1  &kp N2  &kp N3  &kp PLUS   &trans
&trans  &trans  &trans     &trans    &trans     &trans    &trans  &trans  &trans    &trans
&trans  &trans  &trans     &trans    &trans     &trans    &kp N0  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

// //right hand trackball overrides
// &trackball_peripheral_listener {
//     input-processors =
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_temp_layer 3 500>;//activate layer 3 within 500ms of the trackball moving
// };
// //left hand trackball overrides
// &trackball_central_listener {
//     input-processors = 
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_xy_scaler 1 3>,//multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
//         <&zip_xy_to_scroll_mapper>,//make this trackball output scrolling events by default instead of cursor movement
//         <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;//invert vertical scrolling so that the view moves in the same direction as the top of the trackball.
// };
